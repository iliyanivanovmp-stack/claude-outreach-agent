# Exa (required: lead finding and prospect research)
# Get your key at exa.ai. Free tier gives ~1,000 searches/month.
EXA_API_KEY=your-exa-api-key-here

# Gmail OAuth (required: sending and reading replies via MCP)
# Follow the setup steps in README.md Step 3 to get these
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token
